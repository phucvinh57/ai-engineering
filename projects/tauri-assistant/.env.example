CHAT_BASE_URL=http://localhost:11434/v1
CHAT_API_KEY=ollama
CHAT_MODEL=llama3.2
EMBEDDING_MODEL=BAAI/bge-m3
# A smaller, faster alternative -- but it truncates at 256 tokens, so more
# sections get split. Changing this writes to a *different* collection, so
# both can be indexed and compared side by side.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# --- Chunking (see config.example.toml for the full list) ---
CHUNKING_STRATEGY=heading
CHUNKING_MAX_TOKENS=1024
CHUNKING_MIN_TOKENS=64

# --- Telemetry (optional; leave the keys blank to disable all tracing) ---
# Self-hosted (see infra/langfuse/ at the repo root):
LANGFUSE_BASE_URL=http://localhost:3000
# ...or Langfuse Cloud instead -- see infra/langfuse/README.md for the
# privacy trade-off before switching (use your region's cloud host, e.g.
# https://us.cloud.langfuse.com or https://<region>.cloud.langfuse.com):
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST is accepted too, but LANGFUSE_BASE_URL is the SDK's current
# name (LANGFUSE_HOST is deprecated) and takes precedence if both are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=development
LANGFUSE_ENABLED=true
# LANGFUSE_RELEASE=
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_DEBUG=false

# Ask Ollama for token usage on streamed completions; set false if your
# Ollama build 400s on the stream_options field.
CHAT_STREAM_USAGE=true
