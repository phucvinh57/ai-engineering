CHAT_BASE_URL=http://localhost:11434/v1
CHAT_API_KEY=ollama
CHAT_MODEL=llama3.2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Telemetry (optional; leave the keys blank to disable all tracing) ---
# Self-hosted (see infra/langfuse/ at the repo root):
LANGFUSE_HOST=http://localhost:3000
# ...or Langfuse Cloud instead -- see infra/langfuse/README.md for the
# privacy trade-off before switching:
# LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=development
LANGFUSE_ENABLED=true
# LANGFUSE_RELEASE=
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_DEBUG=false

# Ask Ollama for token usage on streamed completions; set false if your
# Ollama build 400s on the stream_options field.
CHAT_STREAM_USAGE=true
