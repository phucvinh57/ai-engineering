# Copy to infra/langfuse/.env and fill in. Generate each secret with:
#   openssl rand -hex 32
# ENCRYPTION_KEY must be exactly 64 hex characters (32 bytes).

# --- Core secrets ---
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
NEXTAUTH_URL=http://localhost:3000

# --- Postgres ---
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=
POSTGRES_DB=langfuse
DATABASE_URL=postgresql://langfuse:CHANGE_ME@postgres:5432/langfuse

# --- ClickHouse ---
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=

# --- Redis ---
REDIS_AUTH=

# --- MinIO (S3-compatible blob storage for event/media uploads) ---
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=

# --- Deterministic local project (auto-provisioned on first boot) ---
# These become the LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY you paste into
# projects/tauri-assistant/.env. Fine to leave as-is for local dev; the app
# never talks to Langfuse Cloud when LANGFUSE_HOST points at this instance.
LANGFUSE_INIT_ORG_ID=tauri-assistant-local
LANGFUSE_INIT_PROJECT_ID=tauri-assistant-local
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-dev
LANGFUSE_INIT_USER_EMAIL=dev@localhost
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_INIT_USER_NAME=Local Dev
